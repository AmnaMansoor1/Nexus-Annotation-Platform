rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // isAdmin() uses get() on admin_config — only call this for WRITE
    // operations (rare). Never call it for reads, as a failed get()
    // (e.g. quota exhausted) causes PERMISSION_DENIED for everyone.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == "admin@gmail.com"
        || (exists(/databases/$(database)/documents/admin_config/settings)
            && get(/databases/$(database)/documents/admin_config/settings).data.admin_emails is list
            && request.auth.token.email.lower() in get(/databases/$(database)/documents/admin_config/settings).data.admin_emails)
      );
    }

    function authEmailLower() {
      return isAuthenticated() ? request.auth.token.email.lower() : "";
    }

    function isAllowedStudentEmail(email) {
      return email.lower() == "admin@gmail.com"
          || email.lower().matches(".*@cuilahore\\.edu\\.pk$");
    }

    function resourceHasEmail(pathField) {
      return resource != null
          && resource.data[pathField] is string
          && resource.data[pathField].lower() == authEmailLower();
    }

    function requestHasEmail(pathField) {
      return request.resource.data[pathField] is string
          && request.resource.data[pathField].lower() == authEmailLower();
    }

    // ── Articles ─────────────────────────────────────────────────────────────
    match /articles/{articleId} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin();
      allow update: if isAuthenticated() &&
                    request.resource.data.diff(resource.data).affectedKeys()
                    .hasAny(['annotation_count', 'annotated_by', 'status',
                             'bias_score', 'percent_agreement', 'fleiss_kappa',
                             'final_label', 'label',
                             'assigned_count', 'assigned_to']);
    }

    // ── Annotators ───────────────────────────────────────────────────────────
    // READ: allow any authenticated user — avoids the get() call inside
    // isAdmin() which fails under quota pressure and blocks everyone.
    // The annotator data (email, progress) is non-sensitive research data.
    match /annotators/{docId} {
      allow read:   if isAuthenticated();
      allow write:  if isAdmin();
      allow update: if resourceHasEmail('email')
                       && isAllowedStudentEmail(resource.data.email);
      allow create: if requestHasEmail('email')
                       && isAllowedStudentEmail(request.resource.data.email);
    }

    // ── Annotation responses ─────────────────────────────────────────────────
    match /annotations/{articleId} {
      allow read: if isAuthenticated();
      match /responses/{docId} {
        allow read:          if isAuthenticated();
        allow create, update: if isAuthenticated()
                               && requestHasEmail('annotator_email')
                               && isAllowedStudentEmail(request.resource.data.annotator_email);
        allow delete:        if isAdmin();
      }
    }

    // Collection-group rule for admin hard-delete pre-scan
    match /{path=**}/responses/{docId} {
      allow read: if isAdmin();
    }

    // ── Admin config ─────────────────────────────────────────────────────────
    match /admin_config/{document=**} {
      allow read:  if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Stats / platform summary ─────────────────────────────────────────────
    match /stats/{document=**} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
